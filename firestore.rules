rules_version = '2';

// ═══════════════════════════════════════════════════════════════════════════
// EgorNetwork — Firestore Security Rules (v2, после чистки сайта)
//
// Принцип: всё запрещено, кроме явно перечисленного ниже.
// Коллекции старой соцсети (conversations, groups, calls, groupCalls,
// live_channels, comments, minis_leaderboard, minis_presence) больше
// НЕ доступны клиентам — их данные стоит удалить в консоли Firebase.
//
// Деплой:  firebase deploy --only firestore:rules
// ═══════════════════════════════════════════════════════════════════════════

service cloud.firestore {
  match /databases/{database}/documents {

    // ── helpers ────────────────────────────────────────────────────────────
    function signedIn() { return request.auth != null; }

    function isAdmin() {
      // Анонимные аккаунты админом быть не могут.
      return signedIn()
        && request.auth.token.firebase.sign_in_provider != 'anonymous'
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Публичный ник: 2–20 символов, буквы/цифры/пробел/_ . -
    function validName(n) {
      return n is string && n.matches('^[A-Za-zА-Яа-яЁё0-9_ .\\-]{2,20}$');
    }

    function incoming() { return request.resource.data; }
    function changed() { return request.resource.data.diff(resource.data).affectedKeys(); }

    // ── Пользователи ───────────────────────────────────────────────────────
    // Раньше любой залогиненный мог читать ВСЕ профили (с email'ами).
    // Теперь — только свой документ. Писать с клиента нельзя вообще:
    // роль admin выдаётся вручную в консоли.
    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;

      // Чёрный список Муравейника: приватный, виден и меняется только владельцем.
      match /blocked/{other} {
        allow read, delete: if member() && request.auth.uid == uid;
        allow create: if member() && request.auth.uid == uid && other != uid
          && incoming().keys().hasOnly(['at']) && incoming().at == request.time;
      }
    }

    // ═════════════════════════════════════════════════════════════════════
    // 🐜 МУРАВЕЙНИК — мессенджер со сквозным шифрованием
    //
    // Сервер (и админ проекта) видит только метаданные: кто в каком чате и
    // когда писал. Текст, картинки и названия групп — шифротекст.
    // Доступ только у аккаунтов email+пароль (анонимные из мини-игр — нет).
    // ═════════════════════════════════════════════════════════════════════
    function member() {
      return signedIn()
        && request.auth.token.firebase.sign_in_provider == 'password';
    }
    function validHandle(h) { return h is string && h.matches('^[a-z0-9_]{3,20}$'); }
    function validB64(s, max) { return s is string && s.size() > 0 && s.size() <= max && s.matches('^[A-Za-z0-9+/=]+$'); }
    function validPub(p) {
      return p is map && p.keys().hasOnly(['dh', 'sig']) && validB64(p.dh, 400) && validB64(p.sig, 400);
    }
    function validAvatar(a) {
      return a == null || (a is string && a.size() <= 60000 && a.matches('^data:image/(webp|jpeg);base64,[A-Za-z0-9+/=]+$'));
    }
    function validBio(b) { return b is string && b.size() <= 280; }
    function hasProfile(uid) { return exists(/databases/$(database)/documents/profiles/$(uid)); }
    function blockedBy(owner, who) {
      return exists(/databases/$(database)/documents/users/$(owner)/blocked/$(who));
    }

    // Публичная карточка: ник, био, аватар, публичные ключи.
    // Только get по uid — перечислить всех пользователей нельзя.
    match /profiles/{uid} {
      allow get: if member();
      allow list: if false;
      allow create: if member() && request.auth.uid == uid
        && incoming().keys().hasOnly(['handle', 'bio', 'avatar', 'pub', 'fp', 'keyVer', 'createdAt', 'updatedAt'])
        && validHandle(incoming().handle)
        && getAfter(/databases/$(database)/documents/handles/$(incoming().handle)).data.uid == uid
        && validBio(incoming().bio) && validAvatar(incoming().avatar)
        && validPub(incoming().pub) && incoming().fp is string && incoming().fp.size() == 64
        && incoming().keyVer == 1
        && incoming().createdAt == request.time && incoming().updatedAt == request.time;
      allow update: if member() && request.auth.uid == uid
        && changed().hasOnly(['bio', 'avatar', 'pub', 'fp', 'keyVer', 'updatedAt'])
        && validBio(incoming().bio) && validAvatar(incoming().avatar)
        && validPub(incoming().pub) && incoming().fp is string && incoming().fp.size() == 64
        // смена ключей (потерян код) обязана поднять версию — клиенты увидят
        && (incoming().pub == resource.data.pub
            ? incoming().keyVer == resource.data.keyVer
            : incoming().keyVer == resource.data.keyVer + 1)
        && incoming().updatedAt == request.time;
      allow delete: if member() && request.auth.uid == uid;
    }

    // Ник → uid. Точный поиск (get), без списка. Ник неизменяем.
    match /handles/{handle} {
      allow get: if member();
      allow list: if false;
      allow create: if member() && validHandle(handle)
        && incoming().keys().hasOnly(['uid']) && incoming().uid == request.auth.uid
        && !exists(/databases/$(database)/documents/profiles/$(request.auth.uid))
        && getAfter(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.handle == handle;
      allow update: if false;
      allow delete: if member() && resource.data.uid == request.auth.uid
        && !existsAfter(/databases/$(database)/documents/profiles/$(request.auth.uid));
    }

    // Зашифрованный бэкап ключей: только владелец. Без кода восстановления бесполезен.
    match /keybackups/{uid} {
      allow get, delete: if member() && request.auth.uid == uid;
      allow create, update: if member() && request.auth.uid == uid
        && incoming().keys().hasOnly(['v', 'iter', 'salt', 'iv', 'ct', 'updatedAt'])
        && incoming().v == 1 && incoming().iter is int && incoming().iter >= 310000
        && validB64(incoming().salt, 64) && validB64(incoming().iv, 64) && validB64(incoming().ct, 4000)
        && incoming().updatedAt == request.time;
    }

    // Чаты: личные (dm) и группы.
    function validEnv(e, maxCt) {
      return e is map && e.keys().hasOnly(['v', 'epk', 'iv', 'ct', 'keys', 'sig'])
        && e.v == 1 && validB64(e.epk, 400) && validB64(e.iv, 64) && validB64(e.ct, maxCt)
        && validB64(e.sig, 200) && e['keys'] is map && e['keys'].size() >= 1 && e['keys'].size() <= 50;
    }
    function isAnthillAdmin(chat) { return chat.type == 'group' && request.auth.uid in chat.admins; }

    match /chats/{chatId} {
      allow get, list: if member() && request.auth.uid in resource.data.members;

      allow create: if member() && request.auth.uid in incoming().members
        && incoming().members is list
        && incoming().createdAt == request.time && incoming().updatedAt == request.time
        && (
          // личный чат: ровно двое, у собеседника есть профиль и он нас не блокировал
          (incoming().type == 'dm'
            && incoming().keys().hasOnly(['type', 'members', 'createdAt', 'updatedAt'])
            && incoming().members.size() == 2
            && incoming().members[0] != incoming().members[1]
            && hasProfile(incoming().members.removeAll([request.auth.uid])[0])
            && !blockedBy(incoming().members.removeAll([request.auth.uid])[0], request.auth.uid))
          ||
          // группа: создатель — единственный админ
          (incoming().type == 'group'
            && incoming().keys().hasOnly(['type', 'members', 'admins', 'meta', 'metaBy', 'createdBy', 'createdAt', 'updatedAt'])
            && incoming().metaBy == request.auth.uid
            && incoming().members.size() >= 2 && incoming().members.size() <= 50
            && incoming().admins == [request.auth.uid]
            && incoming().createdBy == request.auth.uid
            && validEnv(incoming().meta, 2000))
        );

      allow update: if member() && request.auth.uid in resource.data.members
        && incoming().type == resource.data.type
        && incoming().updatedAt == request.time
        && (
          // любой участник: «поднять» чат (новое сообщение)
          changed().hasOnly(['updatedAt'])
          ||
          // админ группы: состав, админы, зашифрованное название
          (isAnthillAdmin(resource.data)
            && changed().hasOnly(['members', 'admins', 'meta', 'metaBy', 'updatedAt'])
            && incoming().members.size() >= 1 && incoming().members.size() <= 50
            && incoming().members.hasAll(incoming().admins)
            && validEnv(incoming().meta, 2000)
            // название перешифровал — значит, подписал он
            && (incoming().meta == resource.data.meta || incoming().metaBy == request.auth.uid))
          ||
          // участник группы выходит сам
          (resource.data.type == 'group'
            && changed().hasOnly(['members', 'admins', 'updatedAt'])
            && incoming().members == resource.data.members.removeAll([request.auth.uid])
            && incoming().admins == resource.data.admins.removeAll([request.auth.uid]))
        );

      allow delete: if member() && (
        (resource.data.type == 'dm' && request.auth.uid in resource.data.members)
        || isAnthillAdmin(resource.data)
      );

      // Сообщения: неизменяемые шифроконверты.
      function chat() { return get(/databases/$(database)/documents/chats/$(chatId)).data; }

      match /messages/{msgId} {
        allow get, list: if member() && request.auth.uid in chat().members;
        allow create: if member()
          && incoming().keys().hasOnly(['sender', 'createdAt', 'env'])
          && incoming().sender == request.auth.uid
          && incoming().createdAt == request.time
          && request.auth.uid in chat().members
          && validEnv(incoming().env, 750000)
          && chat().members.hasAll(incoming().env['keys'].keys())
          && (chat().type == 'group'
              || !blockedBy(chat().members.removeAll([request.auth.uid])[0], request.auth.uid));
        allow update: if false;
        allow delete: if member() && (
          resource.data.sender == request.auth.uid
          || (chat().type == 'group' && request.auth.uid in chat().admins)
        );
      }
    }

    // ── Блог ───────────────────────────────────────────────────────────────
    match /posts/{postId} {
      allow read: if true;
      allow create: if isAdmin()
        && incoming().keys().hasOnly(['title', 'text', 'createdAt'])
        && incoming().title is string && incoming().title.size() > 0 && incoming().title.size() <= 140
        && incoming().text is string && incoming().text.size() > 0 && incoming().text.size() <= 20000
        && incoming().createdAt == request.time;
      // update нужен админу для чистки старых полей author/authorUid.
      allow update, delete: if isAdmin();
    }

    // ── Мини-игры: таблица рекордов ────────────────────────────────────────
    // minis_scores/{game}/entries/{uid}: писать можно только в свою запись,
    // только валидный ник, целый счёт в разумных пределах и не ниже прежнего.
    function validGame(game) {
      return game in ['tetris', 'runner', 'snake', 'starfighter', 'asteroid', 'varoom', 'cosmic'];
    }
    function validEntry() {
      return incoming().keys().hasOnly(['name', 'score', 'updatedAt'])
        && incoming().keys().hasAll(['name', 'score', 'updatedAt'])
        && validName(incoming().name)
        && incoming().score is int
        && incoming().score > 0 && incoming().score <= 100000000
        && incoming().updatedAt == request.time;
    }
    match /minis_scores/{game}/entries/{uid} {
      allow read: if validGame(game);
      allow create: if signedIn() && request.auth.uid == uid && validGame(game) && validEntry();
      allow update: if signedIn() && request.auth.uid == uid && validGame(game) && validEntry()
        && incoming().score >= resource.data.score;
      allow delete: if false;
    }

    // ── Мини-игры: онлайн-лобби (Tetris / Snake) ───────────────────────────
    // Раньше любой залогиненный мог читать/писать/удалять ЛЮБОЕ лобби.
    // Теперь: создать — только за себя как p1; войти — только за себя как p2
    // в чужое ожидающее лобби; дальше каждый игрок пишет только своё поле.
    function validPlayer(p, uid) {
      return p is map
        && p.keys().hasOnly(['uid', 'name', 'score', 'lines', 'level', 'connected', 'lastUpdate', 'x', 'y', 'dir', 'snake'])
        && p.uid == uid
        && validName(p.name)
        && (!('score' in p) || (p.score is int && p.score >= 0 && p.score <= 100000000))
        && (!('snake' in p) || (p.snake is list && p.snake.size() <= 600));
    }
    function isP1() { return resource.data.p1.uid == request.auth.uid; }
    function isP2() { return resource.data.p2 != null && resource.data.p2.uid == request.auth.uid; }
    function statusOk() {
      return incoming().status == resource.data.status || incoming().status == 'ended';
    }
    match /{lobbies}/{lobbyId} {
      allow read: if signedIn() && lobbies in ['tetris_global', 'snake_global'];

      allow create: if signedIn() && lobbies in ['tetris_global', 'snake_global']
        && incoming().keys().hasOnly(['status', 'p1', 'p2', 'createdAt', 'ping'])
        && incoming().status == 'waiting'
        && validPlayer(incoming().p1, request.auth.uid)
        && incoming().p2 == null
        && incoming().createdAt == request.time;

      allow update: if signedIn() && lobbies in ['tetris_global', 'snake_global'] && (
        // p2 входит в чужое ожидающее лобби
        (resource.data.status == 'waiting' && !isP1()
          && changed().hasOnly(['status', 'p2', 'startTime'])
          && incoming().status == 'playing'
          && validPlayer(incoming().p2, request.auth.uid)
          && incoming().startTime == request.time)
        ||
        // p1 обновляет только себя (+ ping/статус завершения)
        (isP1()
          && changed().hasOnly(['p1', 'status', 'endedAt', 'ping'])
          && validPlayer(incoming().p1, request.auth.uid)
          && incoming().p1.name == resource.data.p1.name
          && statusOk())
        ||
        // p2 обновляет только себя
        (isP2()
          && changed().hasOnly(['p2', 'status', 'endedAt'])
          && validPlayer(incoming().p2, request.auth.uid)
          && incoming().p2.name == resource.data.p2.name
          && statusOk())
      );

      // Удалить: участник — всегда; кто угодно — только протухшее лобби.
      allow delete: if signedIn() && lobbies in ['tetris_global', 'snake_global'] && (
        isP1() || isP2()
        || (resource.data.createdAt is timestamp && request.time > resource.data.createdAt + duration.value(10, 'm'))
        || (resource.data.ping is int && request.time.toMillis() - resource.data.ping > 60000)
      );
    }
  }
}
